{
  "extraKnownMarketplaces": {
    "oberchecker": {
      "source": { "source": "github", "repo": "astera/oberchecker" }
    }
  },
  "enabledPlugins": {
    "oberchecker@oberchecker": true,
    "superpowers@oberchecker": true,
    "unslop@oberchecker": true,
    "playwright@oberchecker": true,
    "security-guidance@oberchecker": true,
    "claude-security@claude-plugins-official": true
  },
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)"
    ]
  }
}
